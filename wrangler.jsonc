{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "discord-tabletop",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-21",
  "durable_objects": {
    "bindings": [
      {
        "name": "TABLETOP_ROOM",
        "class_name": "TabletopRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TabletopRoom"]
    }
  ]
}
