{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "discord-tabletop-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "durable_objects": {
    "bindings": [
      {
        "name": "TABLETOP_ROOM",
        "class_name": "TabletopRoom"
      },
      {
        "name": "TABLETOP_SAVE",
        "class_name": "TabletopSave"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TabletopRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TabletopSave"]
    }
  ],
  "exports": {
    "TabletopRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "TabletopSave": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
